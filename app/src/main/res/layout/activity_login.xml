<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/loginRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/boomBg"
    tools:context=".LoginActivity">

    <!-- ═══════════════════════════════════════════════════════════
         BACKGROUND LIGHTS — نورهای فیروزه‌ای
         ═══════════════════════════════════════════════════════════ -->
    <ImageView
        android:id="@+id/bgLight1"
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="-120dp"
        android:layout_marginStart="-100dp"
        android:src="@drawable/bg_bg_light_1"
        android:contentDescription="@null"
        android:alpha="0.7"/>

    <ImageView
        android:id="@+id/bgLight2"
        android:layout_width="360dp"
        android:layout_height="360dp"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="-150dp"
        android:layout_marginEnd="-120dp"
        android:src="@drawable/bg_bg_light_2"
        android:contentDescription="@null"
        android:alpha="0.7"/>

    <ImageView
        android:id="@+id/bgLight3"
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:layout_gravity="center_horizontal|top"
        android:layout_marginTop="280dp"
        android:src="@drawable/bg_bg_light_3"
        android:contentDescription="@null"
        android:alpha="0.6"/>

    <!-- ═══════════════════════════════════════════════════════════
         MAIN CONTENT
         ═══════════════════════════════════════════════════════════ -->
    <ScrollView
        android:id="@+id/loginScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="4dp"
            android:paddingBottom="20dp">

            <!-- ═══════════════════════════════════════════
                 TOP ACTIONS — Language + Theme
                 ═══════════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end"
                android:layout_marginBottom="2dp">

                <!-- Theme Toggle -->
                <FrameLayout
                    android:id="@+id/themeBtn"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_icon_btn"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:elevation="2dp">

                    <ImageView
                        android:id="@+id/themeIcon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_moon"
                        app:tint="@color/boomTextMuted"
                        android:contentDescription="@string/theme_toggle"/>
                </FrameLayout>

                <!-- Language Toggle -->
                <FrameLayout
                    android:id="@+id/langBtn"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_icon_btn"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:elevation="2dp">

                    <TextView
                        android:id="@+id/langCode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="FA"
                        android:textColor="@color/boomTextStrong"
                        android:textSize="11.5sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"
                        android:fontFamily="sans-serif-medium"/>
                </FrameLayout>
            </LinearLayout>

            <!-- ═══════════════════════════════════════════
                 BRAND
                 ═══════════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="20dp">

                <FrameLayout
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:layout_marginBottom="12dp">

                    <ImageView
                        android:id="@+id/brandHalo"
                        android:layout_width="88dp"
                        android:layout_height="88dp"
                        android:layout_gravity="center"
                        android:src="@drawable/bg_bg_light_1"
                        android:alpha="0.4"
                        android:contentDescription="@null"/>

                    <ImageView
                        android:id="@+id/brandLogo"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_gravity="center"
                        android:src="@mipmap/ic_launcher"
                        android:contentDescription="@string/brand_name"
                        android:scaleType="fitCenter"/>
                </FrameLayout>

                <TextView
                    android:id="@+id/brandName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/brand_name"
                    android:textColor="@color/boomTextStrong"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.01"
                    android:layout_marginBottom="2dp"/>

                <TextView
                    android:id="@+id/brandTagline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/brand_tagline"
                    android:textColor="@color/boomTextMuted"
                    android:textSize="12.5sp"/>
            </LinearLayout>

            <!-- ═══════════════════════════════════════════
                 TABS
                 ═══════════════════════════════════════════ -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/loginTabs"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_tab_container"
                app:tabIndicator="@drawable/bg_tab_indicator"
                app:tabIndicatorColor="@color/boomSurface"
                app:tabIndicatorHeight="match_parent"
                app:tabIndicatorGravity="stretch"
                app:tabSelectedTextColor="@color/boomPrimary"
                app:tabTextColor="@color/boomTextMuted"
                app:tabRippleColor="@color/boomPrimarySoft"
                app:tabMode="fixed"
                app:tabGravity="fill"
                android:layout_marginBottom="18dp">

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/login_tab_password"/>

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/login_tab_otp"/>
            </com.google.android.material.tabs.TabLayout>

            <!-- ═══════════════════════════════════════════
                 ERROR ALERT
                 ═══════════════════════════════════════════ -->
            <LinearLayout
                android:id="@+id/errorAlert"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_alert_error"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:layout_marginBottom="14dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_error"
                    app:tint="@color/boomError"
                    android:layout_marginEnd="10dp"
                    android:contentDescription="@null"/>

                <TextView
                    android:id="@+id/errorText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/boomError"
                    android:textSize="12.5sp"
                    android:lineSpacingExtra="3dp"
                    tools:text="نام کاربری یا رمز عبور اشتباه است"/>
            </LinearLayout>

            <!-- ═══════════════════════════════════════════
                 PASSWORD MODE
                 ═══════════════════════════════════════════ -->
            <LinearLayout
                android:id="@+id/passwordMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Username field -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/loginInputLayout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/login_hint_login"
                    app:boxStrokeColor="@color/input_stroke"
                    app:boxStrokeWidth="1.5dp"
                    app:boxStrokeWidthFocused="1.5dp"
                    app:boxBackgroundColor="@color/boomSurface"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:hintTextColor="@color/input_hint"
                    app:startIconDrawable="@drawable/ic_user"
                    app:startIconTint="@color/boomTextSubtle"
                    app:endIconMode="none"
                    android:layout_marginBottom="12dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/loginInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:maxLines="1"
                        android:textColor="@color/boomTextInput"
                        android:textSize="14.5sp"
                        android:fontFamily="sans-serif"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Password field -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/passwordLayout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/login_hint_password"
                    app:boxStrokeColor="@color/input_stroke"
                    app:boxStrokeWidth="1.5dp"
                    app:boxStrokeWidthFocused="1.5dp"
                    app:boxBackgroundColor="@color/boomSurface"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:hintTextColor="@color/input_hint"
                    app:startIconDrawable="@drawable/ic_lock"
                    app:startIconTint="@color/boomTextSubtle"
                    app:endIconMode="password_toggle"
                    app:endIconTint="@color/boomTextSubtle"
                    app:endIconDrawable="@drawable/ic_eye"
                    android:layout_marginBottom="14dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/passwordInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        android:textColor="@color/boomTextInput"
                        android:textSize="14.5sp"
                        android:fontFamily="sans-serif"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Login + Biometric row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/loginBtn"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="@string/login_button"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textAllCaps="false"
                        android:letterSpacing="0"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@android:color/white"
                        app:backgroundTint="@color/boomPrimary"
                        app:cornerRadius="14dp"
                        app:elevation="0dp"/>

                    <FrameLayout
                        android:id="@+id/biometricBtn"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_biometric_btn"
                        android:elevation="6dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="@string/login_biometric_hint">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_fingerprint"
                            app:tint="@android:color/white"
                            android:contentDescription="@null"/>
                    </FrameLayout>
                </LinearLayout>

                <!-- Forgot password -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/forgotBtn"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/login_forgot_password"
                    android:textSize="12.5sp"
                    android:textColor="@color/boomPrimary"
                    android:textAllCaps="false"
                    android:letterSpacing="0"
                    android:fontFamily="sans-serif-medium"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="40dp"
                    app:rippleColor="@color/boomPrimarySoft"/>
            </LinearLayout>

            <!-- ═══════════════════════════════════════════
                 OTP MODE
                 ═══════════════════════════════════════════ -->
            <LinearLayout
                android:id="@+id/otpMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- OTP Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:layout_marginBottom="20dp">

                    <FrameLayout
                        android:layout_width="68dp"
                        android:layout_height="68dp"
                        android:layout_marginBottom="14dp">

                        <ImageView
                            android:id="@+id/otpIconBg"
                            android:layout_width="68dp"
                            android:layout_height="68dp"
                            android:background="@drawable/bg_icon_btn"
                            android:backgroundTint="@color/boomPrimarySoft"/>

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_sms"
                            app:tint="@color/boomPrimary"
                            android:contentDescription="@null"/>
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/otp_title"
                        android:textColor="@color/boomTextStrong"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/otpSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/otp_sub"
                        android:textColor="@color/boomTextMuted"
                        android:textSize="12.5sp"
                        android:gravity="center"/>
                </LinearLayout>

                <!-- OTP Boxes -->
                <LinearLayout
                    android:id="@+id/otpBoxes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layoutDirection="ltr"
                    android:layout_marginBottom="18dp">

                    <EditText
                        android:id="@+id/otp1"
                        style="@style/BoomOtpBox"
                        android:layout_marginEnd="6dp"/>

                    <EditText
                        android:id="@+id/otp2"
                        style="@style/BoomOtpBox"
                        android:layout_marginEnd="6dp"/>

                    <EditText
                        android:id="@+id/otp3"
                        style="@style/BoomOtpBox"
                        android:layout_marginEnd="6dp"/>

                    <EditText
                        android:id="@+id/otp4"
                        style="@style/BoomOtpBox"
                        android:layout_marginEnd="6dp"/>

                    <EditText
                        android:id="@+id/otp5"
                        style="@style/BoomOtpBox"
                        android:layout_marginEnd="6dp"/>

                    <EditText
                        android:id="@+id/otp6"
                        style="@style/BoomOtpBox"/>
                </LinearLayout>

                <!-- Verify button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/verifyOtpBtn"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="@string/login_verify"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:letterSpacing="0"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@android:color/white"
                    app:backgroundTint="@color/boomPrimary"
                    app:cornerRadius="14dp"
                    app:elevation="0dp"
                    android:layout_marginBottom="12dp"/>

                <!-- OTP actions -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/resendBtn"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:text="@string/login_resend"
                        android:textSize="12.5sp"
                        android:textStyle="bold"
                        android:textAllCaps="false"
                        android:letterSpacing="0"
                        android:fontFamily="sans-serif-medium"
                        app:strokeColor="@color/boomPrimary"
                        app:strokeWidth="1.5dp"
                        app:cornerRadius="12dp"
                        android:textColor="@color/boomPrimary"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/backBtn"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:text="@string/login_back"
                        android:textSize="12.5sp"
                        android:textStyle="bold"
                        android:textAllCaps="false"
                        android:letterSpacing="0"
                        android:fontFamily="sans-serif-medium"
                        app:strokeColor="@color/boomPrimary"
                        app:strokeWidth="1.5dp"
                        app:cornerRadius="12dp"
                        android:textColor="@color/boomPrimary"/>
                </LinearLayout>
            </LinearLayout>

            <!-- ═══════════════════════════════════════════
                 REGISTER CTA
                 ═══════════════════════════════════════════ -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/registerCta"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:text="@string/login_register_now"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:letterSpacing="0"
                android:fontFamily="sans-serif-medium"
                app:strokeColor="@color/boomPrimary"
                app:strokeWidth="1.5dp"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_user"
                app:iconTint="@color/boomPrimary"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconSize="18dp"
                android:textColor="@color/boomPrimary"/>

            <!-- ═══════════════════════════════════════════
                 FOOTER — Picasso
                 ═══════════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/common_designed_by"
                    android:textColor="@color/boomTextSubtle"
                    android:textSize="11sp"
                    android:layout_marginEnd="5dp"/>

                <LinearLayout
                    android:id="@+id/picassoFooter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_pill"
                    android:paddingStart="9dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/picassoLogo"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@string/common_agency"
                        android:scaleType="centerCrop"
                        android:layout_marginEnd="5dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/common_agency"
                        android:textColor="@color/boomPrimary"
                        android:textSize="11sp"
                        android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
