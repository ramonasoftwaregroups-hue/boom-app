<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/forgotRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/boomBg">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="16dp"
            android:paddingBottom="20dp">

            <!-- Back bar -->
            <FrameLayout
                android:id="@+id/backBtn"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_icon_btn"
                android:clickable="true"
                android:focusable="true"
                android:elevation="2dp"
                android:layout_marginBottom="20dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_back"
                    app:tint="@color/boomTextStrong"/>
            </FrameLayout>

            <!-- Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="@string/forgot_heading"
                android:textColor="@color/boomTextStrong"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="@string/forgot_sub"
                android:textColor="@color/boomTextMuted"
                android:textSize="13sp"
                android:gravity="center"
                android:layout_marginBottom="28dp"/>

            <!-- Error alert -->
            <LinearLayout
                android:id="@+id/errorAlert"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_alert_error"
                android:padding="12dp"
                android:layout_marginBottom="14dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_error"
                    app:tint="@color/boomError"
                    android:layout_marginEnd="10dp"/>

                <TextView
                    android:id="@+id/errorText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/boomError"
                    android:textSize="12.5sp"/>
            </LinearLayout>

            <!-- Step 1: request code -->
            <LinearLayout
                android:id="@+id/step1Container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/loginInputLayout"
                    style="@style/BoomTextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/forgot_hint_login"
                    app:startIconDrawable="@drawable/ic_user"
                    app:startIconTint="@color/boomTextSubtle"
                    android:layout_marginBottom="14dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/loginInput"
                        style="@style/BoomTextInputEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:maxLines="1"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sendCodeBtn"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="@string/forgot_send_code"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:letterSpacing="0"
                    android:textColor="@android:color/white"
                    app:backgroundTint="@color/boomPrimary"
                    app:cornerRadius="14dp"
                    app:elevation="0dp"/>
            </LinearLayout>

            <!-- Step 2: verify code -->
            <LinearLayout
                android:id="@+id/step2Container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/otpSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="@string/otp_sub"
                    android:textColor="@color/boomTextMuted"
                    android:textSize="12.5sp"
                    android:layout_marginBottom="20dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layoutDirection="ltr"
                    android:layout_marginBottom="18dp">

                    <EditText android:id="@+id/otp1" style="@style/BoomOtpBox" android:layout_marginEnd="6dp"/>
                    <EditText android:id="@+id/otp2" style="@style/BoomOtpBox" android:layout_marginEnd="6dp"/>
                    <EditText android:id="@+id/otp3" style="@style/BoomOtpBox" android:layout_marginEnd="6dp"/>
                    <EditText android:id="@+id/otp4" style="@style/BoomOtpBox" android:layout_marginEnd="6dp"/>
                    <EditText android:id="@+id/otp5" style="@style/BoomOtpBox" android:layout_marginEnd="6dp"/>
                    <EditText android:id="@+id/otp6" style="@style/BoomOtpBox"/>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/verifyBtn"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="@string/forgot_verify"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:letterSpacing="0"
                    android:textColor="@android:color/white"
                    app:backgroundTint="@color/boomPrimary"
                    app:cornerRadius="14dp"
                    app:elevation="0dp"/>
            </LinearLayout>

            <!-- Step 3: new password -->
            <LinearLayout
                android:id="@+id/step3Container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/newPasswordLayout"
                    style="@style/BoomTextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/forgot_hint_new_password"
                    app:endIconMode="password_toggle"
                    android:layout_marginBottom="12dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/newPasswordInput"
                        style="@style/BoomTextInputEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:maxLines="1"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/confirmPasswordLayout"
                    style="@style/BoomTextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/forgot_hint_confirm_password"
                    app:endIconMode="password_toggle"
                    android:layout_marginBottom="14dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/confirmPasswordInput"
                        style="@style/BoomTextInputEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:maxLines="1"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/resetBtn"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="@string/forgot_reset"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:letterSpacing="0"
                    android:textColor="@android:color/white"
                    app:backgroundTint="@color/boomPrimary"
                    app:cornerRadius="14dp"
                    app:elevation="0dp"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
