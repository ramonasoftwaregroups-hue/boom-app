<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/splash_background">

    <!-- ═══════════ SCENE 1 — Boom ═══════════ -->
    <LinearLayout
        android:id="@+id/scene1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:alpha="0">

        <FrameLayout
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_marginBottom="24dp">

            <View
                android:id="@+id/scene1Glow"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_gravity="center"
                android:background="@drawable/splash_glow"
                android:alpha="0"/>

            <ImageView
                android:id="@+id/scene1Logo"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:layout_gravity="center"
                android:src="@mipmap/ic_launcher"
                android:contentDescription="@string/splash_logo_boom"
                android:scaleType="fitCenter"/>
        </FrameLayout>

        <TextView
            android:id="@+id/scene1Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/splash_title"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:letterSpacing="0.01"
            android:alpha="0"/>

        <TextView
            android:id="@+id/scene1Subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/splash_subtitle"
            android:textColor="#B300E5FF"
            android:textSize="12.5sp"
            android:letterSpacing="0.15"
            android:layout_marginTop="8dp"
            android:alpha="0"/>
    </LinearLayout>

    <!-- ═══════════ SCENE 2 — Picasso ═══════════ -->
    <LinearLayout
        android:id="@+id/scene2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="invisible"
        android:alpha="0">

        <FrameLayout
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:layout_marginBottom="24dp">

            <View
                android:id="@+id/scene2Glow"
                android:layout_width="240dp"
                android:layout_height="240dp"
                android:layout_gravity="center"
                android:background="@drawable/splash_glow"
                android:alpha="0"/>

            <ImageView
                android:id="@+id/scene2Logo"
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:layout_gravity="center"
                android:contentDescription="@string/splash_logo_picasso"
                android:scaleType="fitCenter"/>
        </FrameLayout>

        <TextView
            android:id="@+id/scene2Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/splash_caption"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:alpha="0"/>

        <TextView
            android:id="@+id/scene2Accent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/splash_accent"
            android:textColor="#00E5FF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp"
            android:alpha="0"/>
    </LinearLayout>

    <!-- ═══════════ Version badge ═══════════ -->
    <LinearLayout
        android:id="@+id/versionBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="28dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:background="@drawable/splash_badge_bg"
        android:alpha="0">

        <View
            android:id="@+id/versionDot"
            android:layout_width="5dp"
            android:layout_height="5dp"
            android:background="@drawable/version_dot"
            android:layout_marginEnd="6dp"
            android:alpha="0.4"/>

        <TextView
            android:id="@+id/versionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/splash_checking"
            android:textColor="#8CFFFFFF"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.05"/>
    </LinearLayout>

</FrameLayout>
