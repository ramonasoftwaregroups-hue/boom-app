<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ═══════════════════════════════════════════════════════════
         APP THEME — DayNight برای دارک مود خودکار
         ═══════════════════════════════════════════════════════════ -->
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- رنگ‌های Material Components -->
        <item name="colorPrimary">@color/boomPrimary</item>
        <item name="colorPrimaryVariant">@color/boomPrimaryDark</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSecondary">@color/boomPrimaryLight</item>
        <item name="colorSecondaryVariant">@color/boomPrimary</item>
        <item name="colorOnSecondary">@android:color/white</item>
        <item name="colorSurface">@color/boomSurface</item>
        <item name="colorOnSurface">@color/boomTextStrong</item>
        <item name="colorBackground">@color/boomBg</item>
        <item name="colorOnBackground">@color/boomText</item>
        <item name="colorError">@color/boomError</item>
        <item name="colorOnError">@android:color/white</item>

        <!-- Window -->
        <item name="android:windowBackground">@color/boomBg</item>
        <item name="android:colorBackground">@color/boomBg</item>
        <item name="android:statusBarColor">@color/boomStatusBar</item>
        <item name="android:navigationBarColor">@color/boomNavBar</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">@bool/boom_is_light_theme</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowContentTransitions">true</item>
        <item name="android:windowAnimationStyle">@style/BoomWindowAnimation</item>

        <!-- Compatibility -->
        <item name="colorPrimaryDark">@color/boomPrimaryDark</item>
        <item name="colorAccent">@color/boomPrimaryLight</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════
         WINDOW ANIMATION — انیمیشن ورود/خروج نرم
         ═══════════════════════════════════════════════════════════ -->
    <style name="BoomWindowAnimation" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/slide_in_right</item>
        <item name="android:activityOpenExitAnimation">@anim/fade_out</item>
        <item name="android:activityCloseEnterAnimation">@anim/fade_in</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_out_right</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════
         TEXT STYLES
         ═══════════════════════════════════════════════════════════ -->
    <style name="BoomText" parent="android:Widget.TextView">
        <item name="android:textColor">@color/boomText</item>
    </style>

    <style name="BoomText.Brand">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/boomTextStrong</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="BoomText.Tagline">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/boomTextMuted</item>
    </style>

    <style name="BoomText.Title">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/boomTextStrong</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="BoomText.Hint">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/boomTextMuted</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════
         TEXT INPUT LAYOUT — فیلدهای ورودی
         ═══════════════════════════════════════════════════════════ -->
    <style name="BoomTextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/input_stroke</item>
        <item name="boxStrokeWidth">1.5dp</item>
        <item name="boxStrokeWidthFocused">1.5dp</item>
        <item name="boxBackgroundColor">@color/boomSurface</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="hintTextColor">@color/input_hint</item>
        <item name="android:textColorHint">@color/boomTextSubtle</item>
        <item name="errorTextColor">@color/boomError</item>
    </style>

    <style name="BoomTextInputEditText" parent="Widget.MaterialComponents.TextInputEditText.OutlinedBox">
        <item name="android:textColor">@color/boomTextInput</item>
        <item name="android:textSize">14.5sp</item>
        <item name="android:textColorHighlight">@color/boomPrimarySoft</item>
        <item name="android:textCursorDrawable">@null</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════
         BUTTONS
         ═══════════════════════════════════════════════════════════ -->
    <style name="BoomButton" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_height">56dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="backgroundTint">@color/boomPrimary</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="cornerRadius">14dp</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="BoomButton.Primary">
        <item name="backgroundTint">@color/boomPrimary</item>
    </style>

    <style name="BoomButton.Outline" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_height">48dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="strokeColor">@color/boomPrimary</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:textColor">@color/boomPrimary</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="BoomButton.Link" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:textSize">12.5sp</item>
        <item name="android:textColor">@color/boomPrimary</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="elevation">0dp</item>
        <item name="rippleColor">@color/boomPrimarySoft</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════
         TABS — ورود با رمز / ورود با کد
         ═══════════════════════════════════════════════════════════ -->
    <style name="BoomTabLayout" parent="Widget.MaterialComponents.TabLayout">
        <item name="android:background">@color/boomTabBg</item>
        <item name="tabIndicatorColor">@color/boomPrimary</item>
        <item name="tabIndicatorHeight">0dp</item>
        <item name="tabSelectedTextColor">@color/boomPrimary</item>
        <item name="tabTextColor">@color/boomTextMuted</item>
        <item name="tabRippleColor">@color/boomPrimarySoft</item>
        <item name="tabMode">fixed</item>
        <item name="tabGravity">fill</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════
         TAB TEXT APPEARANCE
         ═══════════════════════════════════════════════════════════ -->
    <style name="BoomTabText" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════
         OTP BOX
         ═══════════════════════════════════════════════════════════ -->
    <style name="BoomOtpBox" parent="">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">54dp</item>
        <item name="android:background">@drawable/bg_otp_box</item>
        <item name="android:textAlignment">center</item>
        <item name="android:gravity">center</item>
        <item name="android:inputType">number</item>
        <item name="android:maxLength">1</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/boomTextInput</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:backgroundTint">@android:color/transparent</item>
        <item name="android:cursorVisible">false</item>
        <item name="android:padding">0dp</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════
         ICON BUTTON — زبان و تم
         ═══════════════════════════════════════════════════════════ -->
    <style name="BoomIconButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="cornerRadius">20dp</item>
        <item name="android:textColor">@color/boomTextMuted</item>
        <item name="backgroundTint">@color/boomSurface</item>
        <item name="elevation">2dp</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════
         DIALOG / DROPDOWN
         ═══════════════════════════════════════════════════════════ -->
    <style name="BoomDialogTheme" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorPrimary">@color/boomPrimary</item>
        <item name="colorSurface">@color/boomSurface</item>
        <item name="colorOnSurface">@color/boomTextStrong</item>
        <item name="shapeAppearanceOverlay">@style/BoomDialogShape</item>
    </style>

    <style name="BoomDialogShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════
         SPLASH THEME — بدون عنوان، گرادیان
         ═══════════════════════════════════════════════════════════ -->
    <style name="BoomSplashTheme" parent="AppTheme">
        <item name="android:windowBackground">@drawable/boom_splash_bg</item>
        <item name="android:statusBarColor">@color/boomPrimary</item>
        <item name="android:navigationBarColor">@color/boomPrimaryDark</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

</resources>
